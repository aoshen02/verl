# syntax=docker/dockerfile:1.7
#
# Unified training + rollout image for
# examples/grpo_trainer/run_nemotron_h_lightning_nvfp4_true_on_policy_megatron.sh,
# which it ships with its Hydra groups and model manifests in /opt/nemotron/recipe.
#
# verl is the build context: a clean checkout of the commit holding this file.
# vLLM and Megatron-LM (megatron.core, megatron.lite, verl_mlite) are fetched at
# the commits pinned below; the fetched HEAD must equal the pin and the vLLM
# version is re-derived from the pinned commit's history. All of them go into
# one venv; nothing is mounted at run time. One runtime patch remains, as in
# the DeepSeek-V4 Megatron Lite recipe: importing verl_mlite.engine replaces
# verl's bucketed weight sender (verl_mlite.compat._patch_bucketed_weight_sender).
#
# The pinned vLLM and Megatron-LM commits are not published yet, so builds pass
# a mirror that has them; the pins, not the URLs, identify the sources. The
# release candidate was built on GB200 (arm64) from a clean verl clone, with a
# loopback git daemon serving the mirrors and a BuildKit daemon that allows
# network.host (to reach that git daemon):
#
#   docker buildx build --builder opus-pkg --allow network.host --network host \
#     --platform linux/arm64 -f docker/Dockerfile.nemotron_h_true_on_policy \
#     --build-arg VLLM_REPO=git://127.0.0.1:9419/vllm.git \
#     --build-arg MEGATRON_REPO=git://127.0.0.1:9419/megatron.git \
#     --output type=docker,dest=nemotron-h-true-on-policy.tar \
#     -t verl:nemotron-h-true-on-policy .

# -----------------------------------------------------------------------------
# Base image and release pins
# -----------------------------------------------------------------------------
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
ARG BASE_IMAGE_DIGEST=sha256:2140e699b3beaf7f96a0081fd9c9406bc3832b435cdb60dfa2d261f7d2f34a1c
ARG TARGETARCH=arm64

ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REVISION=a92e2ac3c4c51f2b75c147f228c5928b749973c2
# What setuptools-scm derives for VLLM_REVISION (v0.30.1rc0-618).
ARG VLLM_VERSION=0.30.1rc1.dev618+ga92e2ac3c
ARG MEGATRON_REPO=https://github.com/NVIDIA/Megatron-LM.git
ARG MEGATRON_REVISION=e677989e2cfa76cf82a310d7bdeee49eac5d2a76
ARG TORCH_VERSION_PREFIX=2.13.
ARG MAX_JOBS=64
# Megatron-Core's Mamba kernels; mamba-ssm needs the state_dtype argument
# (state-spaces/mamba#972), which no release has yet.
ARG CAUSAL_CONV1D_REVISION=4f6ae4e26ae5fe8af9372f8d312ab25cc4595223
ARG MAMBA_SSM_REVISION=0048fbf2e7b2f214dcbe703ea3dec2b9647595e1

# -----------------------------------------------------------------------------
# Builder
# -----------------------------------------------------------------------------
FROM ${BASE_IMAGE}@${BASE_IMAGE_DIGEST} AS builder
ARG TARGETARCH
ARG BASE_IMAGE_DIGEST
ARG VLLM_REPO
ARG VLLM_REVISION
ARG VLLM_VERSION
ARG MEGATRON_REPO
ARG MEGATRON_REVISION
ARG TORCH_VERSION_PREFIX
ARG MAX_JOBS
ARG CAUSAL_CONV1D_REVISION
ARG MAMBA_SSM_REVISION

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/local/cuda/bin:/usr/bin:/bin \
    MAX_JOBS=${MAX_JOBS} CMAKE_BUILD_PARALLEL_LEVEL=${MAX_JOBS} \
    PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /src

# vLLM's DeepGEMM JIT runtime includes elfutils/libdwfl.h.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libdw-dev && \
    rm -rf /var/lib/apt/lists/*

# x86_64: H100 (SM90), B200 (SM100), B300 (SM103); arm64: GB200, GB300.
RUN <<'EOF'
set -eux
case "${TARGETARCH}" in
  amd64) torch_archs='9.0a;10.0a;10.3a' ;;
  arm64) torch_archs='10.0a;10.3a' ;;
  *) exit 64 ;;
esac
printf "export TORCH_CUDA_ARCH_LIST='%s'\n" "${torch_archs}" >/tmp/arch.env

for rev in "${VLLM_REVISION}" "${MEGATRON_REVISION}"; do
  printf '%s\n' "${rev}" | grep -Eqx '[0-9a-f]{40}'
  test "${rev}" != 0000000000000000000000000000000000000000
done
test -n "${VLLM_VERSION}"

# clone_exact <dir> <repo> <revision> [depth]
clone_exact() {
  git init "/src/$1"
  git -C "/src/$1" remote add origin "$2"
  git -C "/src/$1" fetch --no-tags ${4:+--depth "$4"} origin "$3"
  git -C "/src/$1" checkout --detach "$3"
  test "$(git -C "/src/$1" rev-parse HEAD)" = "$3"
}
# vLLM keeps its history and release tags so that its version can be derived.
clone_exact vllm "${VLLM_REPO}" "${VLLM_REVISION}"
git -C /src/vllm fetch --no-tags origin 'refs/tags/v*:refs/tags/v*'
clone_exact Megatron-LM "${MEGATRON_REPO}" "${MEGATRON_REVISION}" 1

python3 -c "import torch, sys; sys.exit(not torch.__version__.startswith('${TORCH_VERSION_PREFIX}'))"
python3 -m pip install uv==0.12.5
uv venv --seed --system-site-packages --python "$(command -v python3)" "${VIRTUAL_ENV}"
EOF

# -----------------------------------------------------------------------------
# vLLM wheel from the pinned tree, against the base image's torch
# -----------------------------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/uv <<'EOF'
set -eux
. /tmp/arch.env
cd /src/vllm
# VLLM_VERSION must be what setuptools-scm derives from the clean pinned tree.
# The steps below dirty the tree, so the wheel is then stamped with the pin.
uv pip install setuptools-scm==10.3.4
test "$(python -m setuptools_scm)" = "${VLLM_VERSION}"
# vLLM's supported way to build against a preinstalled torch: drop the torch
# pins from requirements and pyproject.toml.
python tools/use_existing_torch.py
# uv does not count the base image's packages as installed, so drop the
# requirements that must come from it instead of shadowing them in the venv.
printf '%s; sys_platform == "never"\n' torch torchvision torchaudio triton \
  >/tmp/base-image-packages.txt
uv pip install --override /tmp/base-image-packages.txt build -r requirements/build/cuda.txt
uv pip install --override /tmp/base-image-packages.txt -r requirements/cuda.txt
mkdir -p /tmp/wheels
SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_VERSION}" python -m build --wheel --no-isolation --outdir /tmp/wheels /src/vllm
uv pip install --no-deps /tmp/wheels/vllm-*.whl
mkdir -p /opt/nemotron
sha256sum /tmp/wheels/vllm-*.whl | cut -d' ' -f1 >/opt/nemotron/vllm-wheel.sha256
EOF

# -----------------------------------------------------------------------------
# Megatron-LM: megatron.core, megatron.lite and the verl_mlite engine package
# -----------------------------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/uv <<'EOF'
set -eux
. /tmp/arch.env
lite=/src/Megatron-LM/experimental/lite
test -f "${lite}/pyproject.toml"
test -f "${lite}/examples/verl/pyproject.toml"
uv pip install --no-build-isolation --no-deps /src/Megatron-LM
uv pip install --no-build-isolation --no-deps "${lite}"
uv pip install --no-build-isolation --no-deps "${lite}/examples/verl"
EOF

# causal-conv1d and mamba-ssm for the Nemotron-H Mamba VJP, built against the
# base image's torch. Both pass their own -gencode list (sm_100, not sm_100a),
# which takes precedence over TORCH_CUDA_ARCH_LIST; the smoke test checks SASS.
RUN --mount=type=cache,target=/root/.cache/uv <<'EOF'
set -eux
. /tmp/arch.env
export CAUSAL_CONV1D_FORCE_BUILD=TRUE MAMBA_FORCE_BUILD=TRUE
uv pip install --no-build-isolation --no-deps \
  "causal-conv1d @ git+https://github.com/Dao-AILab/causal-conv1d.git@${CAUSAL_CONV1D_REVISION}" \
  "mamba-ssm @ git+https://github.com/state-spaces/mamba.git@${MAMBA_SSM_REVISION}"
EOF

# -----------------------------------------------------------------------------
# verl from this checkout with its runtime dependencies, never replacing torch
# or vLLM, and the recipe
# -----------------------------------------------------------------------------
COPY . /src/verl
RUN --mount=type=cache,target=/root/.cache/uv <<'EOF'
set -eux
# Not run from /src/verl: uv would apply verl's own [tool.uv] overrides.
test -z "$(git -C /src/verl status --porcelain --untracked-files=all)"
git -C /src/verl rev-parse HEAD >/opt/nemotron/verl-revision
uv pip freeze | grep -iE '^(torch|torchvision|torchaudio|vllm|flashinfer-python|transformers|megatron-core)==' \
  >/tmp/constraints.txt
# Keep vLLM's exact transformers build instead of re-resolving it for verl.
grep -i '^transformers==' /tmp/constraints.txt | cat - /tmp/base-image-packages.txt >/tmp/overrides.txt
# The Megatron Lite verl config resolves `oc.select` defaults that are dicts,
# which needs omegaconf 2.4 (hydra-core 1.4); the DeepSeek-V4 recipe pins the same.
uv pip install -c /tmp/constraints.txt --override /tmp/overrides.txt "/src/verl[verl-core]" \
  hydra-core==1.4.0.dev8
install -d /opt/nemotron/recipe
cp /src/verl/examples/grpo_trainer/run_nemotron_h_lightning_nvfp4_true_on_policy_megatron.sh \
  /opt/nemotron/recipe/
cp -r /src/verl/examples/grpo_trainer/nemotron_h_true_on_policy /opt/nemotron/recipe/
EOF

# -----------------------------------------------------------------------------
# Provenance and cleanup
# -----------------------------------------------------------------------------
RUN <<'EOF'
set -eux
for pkg in verl vllm megatron-core causal-conv1d mamba-ssm; do uv pip show "${pkg}" >/dev/null; done
printf '{"schema":"nemotron-h-true-on-policy-image/v2","base_image_digest":"%s","vllm_revision":"%s","vllm_version":"%s","megatron_revision":"%s","verl_revision":"%s","causal_conv1d_revision":"%s","mamba_ssm_revision":"%s","vllm_wheel_sha256":"%s"}\n' \
  "${BASE_IMAGE_DIGEST}" "${VLLM_REVISION}" "${VLLM_VERSION}" "${MEGATRON_REVISION}" \
  "$(cat /opt/nemotron/verl-revision)" "${CAUSAL_CONV1D_REVISION}" "${MAMBA_SSM_REVISION}" \
  "$(cat /opt/nemotron/vllm-wheel.sha256)" >/opt/nemotron/image-manifest.json
uv pip freeze >/opt/nemotron/pip-freeze.txt
rm -rf /src /tmp/wheels /tmp/arch.env /tmp/constraints.txt /root/.cache
EOF

# -----------------------------------------------------------------------------
# Runtime image
# -----------------------------------------------------------------------------
FROM ${BASE_IMAGE}@${BASE_IMAGE_DIGEST} AS runtime
ARG TARGETARCH
ARG BASE_IMAGE_DIGEST
ARG VLLM_REVISION
ARG VLLM_VERSION
ARG MEGATRON_REVISION
# BASH_ENV/ENV: the NGC shell hook (/etc/shinit_v2) selects the GCP NCCL
# plugins on GCP hosts with RDMA NICs, and NCCL init then fails in a container
# without /dev/infiniband. HF_HUB_OFFLINE: models come from local paths only.
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/local/cuda/bin:/usr/bin:/bin \
    PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
    BASH_ENV= ENV= \
    HF_HUB_OFFLINE=1
RUN apt-get update && \
    apt-get install -y --no-install-recommends rdma-core libibverbs1 pciutils procps libdw1 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/nemotron /opt/nemotron

# Smoke test of the runtime image: imports, the vLLM version, torch from the
# base image, GB200 SASS in the compiled extensions, and the recipe's full
# Hydra compose, validation and resolution (with stub inputs).
RUN <<'EOF'
set -eux
# Transformer Engine loads libcuda at import; the build has no GPU driver.
mkdir -p /tmp/cuda-stubs
ln -s /usr/local/cuda/lib64/stubs/libcuda.so /tmp/cuda-stubs/libcuda.so.1
export LD_LIBRARY_PATH=/tmp/cuda-stubs${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
VLLM_VERSION="${VLLM_VERSION}" python - <<'PY'
import importlib.util
import os
import pathlib
import sys

import megatron.lite.model.nemotron_h.protocol  # noqa: F401
import torch
import triton
from causal_conv1d import causal_conv1d_fn  # noqa: F401
from mamba_ssm.ops.triton.ssd_combined import mamba_chunk_scan_combined  # noqa: F401
import verl.trainer.main_ppo  # noqa: F401
import verl_mlite.engine  # noqa: F401
import vllm

base = "/usr/local/lib/python3.12/dist-packages/"
for module in (torch, triton):
    assert module.__file__.startswith(base), module.__file__
assert not list(pathlib.Path("/opt/venv").rglob("torch-*.dist-info"))
assert importlib.util.find_spec("verl_mlite.config") is not None
for hook in ("sitecustomize", "usercustomize"):
    spec = importlib.util.find_spec(hook)
    if spec is not None and spec.origin:
        assert "verl_mlite" not in pathlib.Path(spec.origin).read_text(), spec.origin
for pth in pathlib.Path("/opt/venv/lib/python3.12/site-packages").glob("*.pth"):
    assert "verl_mlite" not in pth.read_text(), pth
assert vllm.__version__ == os.environ["VLLM_VERSION"], vllm.__version__
print(sys.version, torch.__version__, vllm.__version__)
PY
site=/opt/venv/lib/python3.12/site-packages
for so in "${site}"/vllm/_C_stable_libtorch.abi3.so "${site}"/vllm/_moe_C_stable_libtorch.abi3.so; do
  cuobjdump --list-elf "${so}" >/tmp/elf.txt
  grep -q '\.sm_100a\.' /tmp/elf.txt
done
for so in "${site}"/causal_conv1d_cuda*.so "${site}"/selective_scan_cuda*.so; do
  cuobjdump --list-elf "${so}" >/tmp/elf.txt
  grep -Eq '\.sm_100a?\.' /tmp/elf.txt
done
MODEL_PATH=/stub/nvfp4 BF16_MASTER_PATH=/stub/bf16 TRAIN_FILES=/stub/train.parquet VAL_FILES=/stub/val.parquet \
  COMPOSE_ONLY=1 bash /opt/nemotron/recipe/run_nemotron_h_lightning_nvfp4_true_on_policy_megatron.sh \
  >/tmp/compose.log
rm -rf /tmp/cuda-stubs /tmp/elf.txt /tmp/compose.log
EOF

LABEL org.opencontainers.image.title="verl-nemotron-h-true-on-policy" \
      ai.nemotron.arch="${TARGETARCH}" \
      ai.nemotron.base.digest="${BASE_IMAGE_DIGEST}" \
      ai.nemotron.vllm.revision="${VLLM_REVISION}" \
      ai.nemotron.vllm.version="${VLLM_VERSION}" \
      ai.nemotron.megatron.revision="${MEGATRON_REVISION}"
WORKDIR /workspace
